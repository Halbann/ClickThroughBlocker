<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<RootNamespace>ClickThroughFix</RootNamespace>
		<AssemblyName>ClickThroughBlocker</AssemblyName>
		<TargetFramework>net48</TargetFramework>
		<Version>3.0.0.0</Version>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>
	<!-- General -->
	<PropertyGroup>
		<RepoRoot>$(SolutionDir)</RepoRoot>
	</PropertyGroup>
	<!-- KSPBT -->
	<PropertyGroup>
		<KSPBT_ModRoot>$(MSBuildProjectDirectory)/../GameData/000_ClickThroughBlocker/</KSPBT_ModRoot>
		<KSPBT_ModPluginFolder>Plugins</KSPBT_ModPluginFolder>
	</PropertyGroup>
	<!-- Dependencies -->
	<ItemGroup>
		<ModReference Include="HarmonyKSP">
			<DLLPath>GameData/000_Harmony/0Harmony.dll</DLLPath>
			<CKANIdentifier>HarmonyKSP</CKANIdentifier>
		</ModReference>
	</ItemGroup>
	<!-- Version Files -->
	<ItemGroup>
		<KSPVersionFile Include="$(RepoRoot)ClickThroughBlocker.version">
			<Destination>$(KSPBT_ModRoot)/ClickThroughBlocker.version</Destination>
			<KSP_Version>1.12</KSP_Version>
			<KSP_Version_Min>1.11.0</KSP_Version_Min>
			<KSP_Version_Max>1.12.99</KSP_Version_Max>
		</KSPVersionFile>
	</ItemGroup>
	<!-- Packages -->
	<ItemGroup>
		<PackageReference Include="KSPBuildTools" Version="1.1.1" />
	</ItemGroup>
	<!-- Copy mod folder to game -->
	<Target Name="CopyToGame" AfterTargets="Build;KSPBT_GenerateVersionFile" Condition="'$(Configuration)' == 'Debug'">
		<ItemGroup>
			<ModFiles Include="$(KSPBT_ModRoot)**\*" />
		</ItemGroup>
		<Copy SourceFiles="@(ModFiles)" DestinationFiles="@(ModFiles->'$(KSPBT_GameRoot)/GameData/000_ClickThroughBlocker/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
	</Target>
</Project>
